{
  "name": "hisaab-kitaab-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Hisaab Kitaab personal finance API (Node.js + Express + MongoDB)",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings src/index.js",
    "dev": "node --watch --env-file-if-exists=.env --no-warnings src/index.js",
    "test": "node --test --no-warnings \"tests/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.10.0"
  }
}
