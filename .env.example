PORT=4000
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put your own user and password in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster
MONGODB_DB=hisaab
# Long random string used to sign login tokens. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: emails the password-reset code (free key at resend.com). Without it the code is printed in this server's console.
RESEND_API_KEY=
MAIL_FROM=Hisaab Kitaab <onboarding@resend.dev>
# Optional: Google sign-in. Comma-separated OAuth client IDs (web, android, ios) from console.cloud.google.com
GOOGLE_CLIENT_IDS=
